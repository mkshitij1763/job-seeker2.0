# Local development. For the server, use scripts/server/env.example (it lists the same names; JOBSEEKER_HOME comes from systemd there).
# Keys: `uv run jobseeker gen-key` prints 32 random bytes as base64. Use a different one for each of SECRET_KEY, TOKEN_KEY and BACKUP_KEY.

# Where data/ and config/app.yaml live: a full path, outside the repo
JOBSEEKER_HOME=

# Required to start the web app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly the browser origin, no trailing slash, or every POST gets a 403
BASE_URL=http://127.0.0.1:8000
SECRET_KEY=
TOKEN_KEY=
OWNER_EMAIL=
# false only for local http; the server keeps the default (true)
COOKIE_SECURE=false

# AI: Groq is required for runs; the others are optional fallbacks
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Outreach: Tavily is needed for Find contacts; Apify and Hunter are optional
TAVILY_API_KEY=
APIFY_API_TOKEN=
HUNTER_API_KEY=

# Optional: backups (default dir: iCloud Drive if on, else ~/JobSeeker-backups) and an encrypted B2 copy
# BACKUP_DIR=  (leave commented: an empty value means the current directory)
BACKUP_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=

# Optional: push notifications (`uv run jobseeker vapid-keys`) and a Healthchecks.io ping URL
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
HEALTHCHECK_PING_URL=
