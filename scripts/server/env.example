APIFY_API_TOKEN=
HUNTER_API_KEY=
BACKUP_DIR=/srv/jobseeker/data/backups
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=
OWNER_EMAIL=
BASE_URL=
COOKIE_SECURE=true
TOKEN_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
BACKUP_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
HEALTHCHECK_PING_URL=
